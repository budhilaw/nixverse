# Template for secrets/homelab-lenovo.yaml (decryptable by the Mac and by the
# homelab's SSH host key). Edit the real file with:
#   SOPS_AGE_KEY_FILE=~/.config/sops/age/keys.txt sops secrets/homelab-lenovo.yaml
# Values below mirror what /opt/*/.env and docker-compose.yml held on Ubuntu.
cloudflared:
  token: CHANGE_ME            # Cloudflare Zero Trust tunnel token (eyJ...)
gluetun:
  env: |
    WIREGUARD_PRIVATE_KEY=CHANGE_ME
vaultwarden:
  env: |
    ADMIN_TOKEN=CHANGE_ME
immich:
  server-env: |
    DB_PASSWORD=CHANGE_ME
  postgres-env: |
    POSTGRES_PASSWORD=CHANGE_ME   # same value as DB_PASSWORD
seafile:
  mysql-env: |
    MYSQL_ROOT_PASSWORD=CHANGE_ME
  redis-env: |
    REDIS_PASSWORD=CHANGE_ME
  server-env: |
    SEAFILE_MYSQL_DB_PASSWORD=CHANGE_ME
    INIT_SEAFILE_MYSQL_ROOT_PASSWORD=CHANGE_ME
    REDIS_PASSWORD=CHANGE_ME
    JWT_PRIVATE_KEY=CHANGE_ME
    SEAFILE_AI_SECRET_KEY=CHANGE_ME   # same value as JWT_PRIVATE_KEY
    INIT_SEAFILE_ADMIN_EMAIL=CHANGE_ME
    INIT_SEAFILE_ADMIN_PASSWORD=CHANGE_ME
